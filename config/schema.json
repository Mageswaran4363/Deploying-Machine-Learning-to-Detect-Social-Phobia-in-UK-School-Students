{
  "version": "2.0",
  "description": "Schema v2.0 — UKDA-8467 (MHCYP 2017) adaptation. Features are SDQ subscales (parent + self-report) and WEMWBS wellbeing. Target is ICD-10 Social Phobia diagnosis (dcsoph=2). No SPIN items are available in this dataset. Column names kept consistent with pipeline interfaces where possible.",
  "group_col": "school_id",
  "max_missing_spin_items": 2,
  "split_ratios": { "train": 0.70, "validation": 0.15, "test": 0.15 },

  "risk_cutoffs": {
    "at_risk_threshold": 0,
    "moderate_lower": 0,
    "high_lower": 0,
    "description": "Not applicable to UKDA real data. spin_risk_binary is derived from ICD-10 clinical diagnosis (dcsoph=2), not a score threshold. Keys retained for config.py backward-compatibility."
  },

  "spin_subscales": {
    "description": "No SPIN items in UKDA-8467. Keys retained for config.py compatibility; all lists are empty. Use sdq_subscales for SDQ groupings.",
    "fear":          [],
    "avoidance":     [],
    "physiological": []
  },

  "spin_max_scores": {
    "fear": 0,
    "avoidance": 0,
    "physiological": 0,
    "total": 0
  },

  "sdq_subscales": {
    "description": "SDQ subscale groupings used by feature_engineering.py.",
    "parent_internalising":  ["psdq_emotional", "psdq_peer"],
    "self_internalising":    ["sdq_emotional",  "sdq_peer"],
    "parent_externalising":  ["psdq_conduct",   "psdq_hyper"],
    "self_externalising":    ["sdq_conduct",    "sdq_hyper"],
    "parent_sdq_items":      ["psdq_emotional", "psdq_peer", "psdq_conduct", "psdq_hyper", "psdq_prosocial"],
    "self_sdq_items":        ["sdq_emotional",  "sdq_peer",  "sdq_conduct",  "sdq_hyper",  "sdq_prosocial"]
  },

  "columns": [

    {
      "name": "participant_id",
      "label": "Participant Pseudonym ID",
      "type": "string",
      "group": "identifier",
      "required": true,
      "missing_allowed": false,
      "used_in_modelling": false,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "drop",
      "apply_scaling": false,
      "imputation_strategy": "none",
      "lay_label": null,
      "notes": "Derived from UKDA seriala field. No link to real identity."
    },

    {
      "name": "school_id",
      "label": "Sampling Cluster ID",
      "type": "string",
      "group": "identifier",
      "required": true,
      "missing_allowed": false,
      "used_in_modelling": false,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "drop",
      "apply_scaling": false,
      "imputation_strategy": "none",
      "lay_label": null,
      "notes": "Derived from UKDA PSUa (primary sampling unit). Used as group variable for StratifiedGroupKFold."
    },

    {
      "name": "cohort_wave",
      "label": "Survey Year",
      "type": "integer",
      "group": "metadata",
      "required": false,
      "missing_allowed": true,
      "valid_min": 1999,
      "valid_max": 2025,
      "used_in_modelling": false,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "drop",
      "apply_scaling": false,
      "imputation_strategy": "none",
      "lay_label": null
    },

    {
      "name": "consent_obtained",
      "label": "Consent Obtained",
      "type": "integer",
      "group": "metadata",
      "required": false,
      "missing_allowed": false,
      "valid_min": 0,
      "valid_max": 1,
      "valid_categories": [0, 1],
      "used_in_modelling": false,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "drop",
      "apply_scaling": false,
      "imputation_strategy": "none",
      "lay_label": null,
      "notes": "All UKDA survey participants gave consent; set to 1 for all rows."
    },

    {
      "name": "data_quality_flag",
      "label": "Data Quality Flag",
      "type": "integer",
      "group": "metadata",
      "required": false,
      "missing_allowed": false,
      "valid_min": 0,
      "valid_max": 1,
      "valid_categories": [0, 1],
      "used_in_modelling": false,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "drop",
      "apply_scaling": false,
      "imputation_strategy": "none",
      "lay_label": null,
      "notes": "0=clean; 1=flagged for exclusion. All UKDA rows set to 0."
    },

    {
      "name": "spin_items_missing",
      "label": "Count of Missing Parent SDQ Items",
      "type": "integer",
      "group": "metadata",
      "valid_min": 0,
      "valid_max": 5,
      "required": false,
      "missing_allowed": false,
      "used_in_modelling": false,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "drop",
      "apply_scaling": false,
      "imputation_strategy": "none",
      "lay_label": null,
      "notes": "Counts missing parent SDQ items (psdq_emotional/peer/conduct/hyper/prosocial). Named spin_items_missing for pipeline compatibility."
    },

    {
      "name": "spin_complete_flag",
      "label": "Full Parent SDQ Completion Flag",
      "type": "integer",
      "group": "metadata",
      "valid_min": 0,
      "valid_max": 1,
      "required": false,
      "missing_allowed": false,
      "used_in_modelling": false,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "drop",
      "apply_scaling": false,
      "imputation_strategy": "none",
      "lay_label": null,
      "notes": "1 if spin_items_missing == 0. Named for pipeline compatibility."
    },

    {
      "name": "spin_risk_binary",
      "label": "Binary Social Phobia Risk Label",
      "type": "integer",
      "group": "target",
      "valid_min": 0,
      "valid_max": 1,
      "valid_categories": [0, 1],
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": false,
      "used_in_fairness_audit": false,
      "is_primary_target": true,
      "encoding": "drop",
      "apply_scaling": false,
      "imputation_strategy": "none",
      "lay_label": "ICD-10 social phobia diagnosis",
      "notes": "1 = ICD-10 social phobia diagnosis (dcsoph=2 in MHCYP 2017). Prevalence ~2% in school-age sample."
    },

    {
      "name": "age_years",
      "label": "Age in Completed Years",
      "type": "integer",
      "group": "demographic",
      "valid_min": 11,
      "valid_max": 18,
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "passthrough",
      "apply_scaling": true,
      "imputation_strategy": "median",
      "lay_label": "Age in years"
    },

    {
      "name": "gender",
      "label": "Gender",
      "type": "string",
      "group": "demographic",
      "valid_categories": ["male", "female"],
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": false,
      "used_in_fairness_audit": true,
      "is_primary_target": false,
      "encoding": "onehot",
      "apply_scaling": false,
      "imputation_strategy": "none",
      "lay_label": "Gender",
      "notes": "Used in fairness audit only; excluded from model features to avoid gender-biased predictions."
    },

    {
      "name": "ethnicity_bme",
      "label": "BME Ethnicity Flag",
      "type": "integer",
      "group": "demographic",
      "valid_min": 0,
      "valid_max": 1,
      "valid_categories": [0, 1],
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": false,
      "used_in_fairness_audit": true,
      "is_primary_target": false,
      "encoding": "binary",
      "apply_scaling": false,
      "imputation_strategy": "none",
      "lay_label": "Black and minority ethnic background",
      "notes": "0=white; 1=BME. From UKDA ethnic_bme. Used in fairness audit only."
    },

    {
      "name": "deprivation_quintile",
      "label": "Index of Multiple Deprivation Quintile",
      "type": "integer",
      "group": "demographic",
      "valid_min": 1,
      "valid_max": 5,
      "valid_categories": [1, 2, 3, 4, 5],
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": true,
      "is_primary_target": false,
      "encoding": "ordinal",
      "ordinal_categories": [1, 2, 3, 4, 5],
      "apply_scaling": false,
      "imputation_strategy": "median",
      "lay_label": "Area deprivation quintile (1=least, 5=most deprived)"
    },

    {
      "name": "sen_status",
      "label": "Special Educational Needs Status",
      "type": "integer",
      "group": "demographic",
      "valid_min": 0,
      "valid_max": 1,
      "valid_categories": [0, 1],
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": true,
      "is_primary_target": false,
      "encoding": "binary",
      "apply_scaling": false,
      "imputation_strategy": "zero",
      "lay_label": "Has special educational needs",
      "notes": "Derived from UKDA ParentSN (1=SEN → 1, 2=no SEN → 0)."
    },

    {
      "name": "learning_difficulty_level",
      "label": "Learning Difficulty Severity",
      "type": "integer",
      "group": "demographic",
      "valid_min": 1,
      "valid_max": 4,
      "valid_categories": [1, 2, 3, 4],
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "ordinal",
      "ordinal_categories": [1, 2, 3, 4],
      "apply_scaling": false,
      "imputation_strategy": "conservative_min",
      "lay_label": "Learning difficulty level (1=none, 4=severe)",
      "notes": "From UKDA Lrndifa. 1=no difficulty, 2=mild, 3=moderate, 4=severe."
    },

    {
      "name": "psdq_emotional",
      "label": "Parent SDQ — Emotional Problems",
      "type": "integer",
      "group": "parent_sdq",
      "valid_min": 0,
      "valid_max": 10,
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "passthrough",
      "apply_scaling": true,
      "imputation_strategy": "mice",
      "lay_label": "Parent-rated emotional difficulties (0–10)"
    },

    {
      "name": "psdq_peer",
      "label": "Parent SDQ — Peer Problems",
      "type": "integer",
      "group": "parent_sdq",
      "valid_min": 0,
      "valid_max": 10,
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "passthrough",
      "apply_scaling": true,
      "imputation_strategy": "mice",
      "lay_label": "Parent-rated peer relationship difficulties (0–10)"
    },

    {
      "name": "psdq_conduct",
      "label": "Parent SDQ — Conduct Problems",
      "type": "integer",
      "group": "parent_sdq",
      "valid_min": 0,
      "valid_max": 10,
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "passthrough",
      "apply_scaling": true,
      "imputation_strategy": "mice",
      "lay_label": "Parent-rated conduct difficulties (0–10)"
    },

    {
      "name": "psdq_hyper",
      "label": "Parent SDQ — Hyperactivity",
      "type": "integer",
      "group": "parent_sdq",
      "valid_min": 0,
      "valid_max": 10,
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "passthrough",
      "apply_scaling": true,
      "imputation_strategy": "mice",
      "lay_label": "Parent-rated hyperactivity/inattention (0–10)",
      "notes": "Derived from phyper_corrected (not phyper, which is absent from UKDA-8467)."
    },

    {
      "name": "psdq_prosocial",
      "label": "Parent SDQ — Prosocial Behaviour",
      "type": "integer",
      "group": "parent_sdq",
      "valid_min": 0,
      "valid_max": 10,
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "passthrough",
      "apply_scaling": true,
      "imputation_strategy": "mice",
      "lay_label": "Parent-rated prosocial behaviour (0–10)"
    },

    {
      "name": "psdq_total",
      "label": "Parent SDQ — Total Difficulties",
      "type": "integer",
      "group": "parent_sdq",
      "valid_min": 0,
      "valid_max": 40,
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": false,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "passthrough",
      "apply_scaling": true,
      "imputation_strategy": "none",
      "lay_label": "Parent-rated total difficulty score (0–40)",
      "notes": "Excluded from model features (collinear with sum of subscales). Used to compute parent_self_discrepancy."
    },

    {
      "name": "sdq_emotional",
      "label": "Self SDQ — Emotional Problems",
      "type": "integer",
      "group": "self_sdq",
      "valid_min": 0,
      "valid_max": 10,
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "passthrough",
      "apply_scaling": true,
      "imputation_strategy": "mice",
      "lay_label": "Self-rated emotional difficulties (0–10)"
    },

    {
      "name": "sdq_peer",
      "label": "Self SDQ — Peer Problems",
      "type": "integer",
      "group": "self_sdq",
      "valid_min": 0,
      "valid_max": 10,
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "passthrough",
      "apply_scaling": true,
      "imputation_strategy": "mice",
      "lay_label": "Self-rated peer relationship difficulties (0–10)"
    },

    {
      "name": "sdq_conduct",
      "label": "Self SDQ — Conduct Problems",
      "type": "integer",
      "group": "self_sdq",
      "valid_min": 0,
      "valid_max": 10,
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "passthrough",
      "apply_scaling": true,
      "imputation_strategy": "mice",
      "lay_label": "Self-rated conduct difficulties (0–10)"
    },

    {
      "name": "sdq_hyper",
      "label": "Self SDQ — Hyperactivity",
      "type": "integer",
      "group": "self_sdq",
      "valid_min": 0,
      "valid_max": 10,
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "passthrough",
      "apply_scaling": true,
      "imputation_strategy": "mice",
      "lay_label": "Self-rated hyperactivity/inattention (0–10)"
    },

    {
      "name": "sdq_prosocial",
      "label": "Self SDQ — Prosocial Behaviour",
      "type": "integer",
      "group": "self_sdq",
      "valid_min": 0,
      "valid_max": 10,
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "passthrough",
      "apply_scaling": true,
      "imputation_strategy": "mice",
      "lay_label": "Self-rated prosocial behaviour (0–10)"
    },

    {
      "name": "sdq_total",
      "label": "Self SDQ — Total Difficulties",
      "type": "integer",
      "group": "self_sdq",
      "valid_min": 0,
      "valid_max": 40,
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": false,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "passthrough",
      "apply_scaling": true,
      "imputation_strategy": "none",
      "lay_label": "Self-rated total difficulty score (0–40)",
      "notes": "Excluded from model features (collinear with subscales). Used to compute parent_self_discrepancy."
    },

    {
      "name": "wellbeing_wemwbs",
      "label": "WEMWBS Wellbeing Score",
      "type": "float",
      "group": "wellbeing",
      "valid_min": 14.0,
      "valid_max": 70.0,
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "passthrough",
      "apply_scaling": true,
      "imputation_strategy": "mice",
      "lay_label": "Warwick-Edinburgh Mental Wellbeing score (14–70)"
    },

    {
      "name": "bullied_flag",
      "label": "Bullied at School",
      "type": "integer",
      "group": "behavioural",
      "valid_min": 0,
      "valid_max": 1,
      "valid_categories": [0, 1],
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "binary",
      "apply_scaling": false,
      "imputation_strategy": "mode",
      "lay_label": "Has been bullied at school",
      "notes": "Derived from Bullyexp (1=bullied→1, 2=not bullied→0)."
    },

    {
      "name": "cyberbullied_flag",
      "label": "Cyberbullied",
      "type": "integer",
      "group": "behavioural",
      "valid_min": 0,
      "valid_max": 1,
      "valid_categories": [0, 1],
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "binary",
      "apply_scaling": false,
      "imputation_strategy": "mode",
      "lay_label": "Has been cyberbullied"
    },

    {
      "name": "sdq_internalising",
      "label": "SDQ Internalising Score (Self)",
      "type": "integer",
      "group": "sdq_derived",
      "valid_min": 0,
      "valid_max": 20,
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "passthrough",
      "apply_scaling": true,
      "imputation_strategy": "none",
      "lay_label": "Self-rated internalising problems (emotional + peer, 0–20)",
      "notes": "sdq_emotional + sdq_peer. Key social phobia proxy from self-report SDQ."
    },

    {
      "name": "psdq_internalising",
      "label": "SDQ Internalising Score (Parent)",
      "type": "integer",
      "group": "sdq_derived",
      "valid_min": 0,
      "valid_max": 20,
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "passthrough",
      "apply_scaling": true,
      "imputation_strategy": "none",
      "lay_label": "Parent-rated internalising problems (emotional + peer, 0–20)",
      "notes": "psdq_emotional + psdq_peer."
    },

    {
      "name": "parent_self_discrepancy",
      "label": "Parent–Self SDQ Discrepancy",
      "type": "integer",
      "group": "sdq_derived",
      "valid_min": -40,
      "valid_max": 40,
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "passthrough",
      "apply_scaling": true,
      "imputation_strategy": "none",
      "lay_label": "Gap between parent and self SDQ total scores",
      "notes": "psdq_total − sdq_total. Positive = parent rates higher difficulty than child."
    },

    {
      "name": "wellbeing_low_flag",
      "label": "Low Wellbeing Flag",
      "type": "integer",
      "group": "sdq_derived",
      "valid_min": 0,
      "valid_max": 1,
      "valid_categories": [0, 1],
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "binary",
      "apply_scaling": false,
      "imputation_strategy": "none",
      "lay_label": "WEMWBS below clinical concern threshold (< 40)",
      "notes": "1 if wellbeing_wemwbs < 40.0 (approx. 1 SD below UK mean of 51.9)."
    },

    {
      "name": "any_bullying",
      "label": "Any Bullying (School or Cyber)",
      "type": "integer",
      "group": "sdq_derived",
      "valid_min": 0,
      "valid_max": 1,
      "valid_categories": [0, 1],
      "required": false,
      "missing_allowed": true,
      "used_in_modelling": true,
      "used_in_fairness_audit": false,
      "is_primary_target": false,
      "encoding": "binary",
      "apply_scaling": false,
      "imputation_strategy": "none",
      "lay_label": "Has experienced any bullying (school or online)",
      "notes": "1 if bullied_flag == 1 OR cyberbullied_flag == 1."
    }

  ]
}
